#!/bin/sh
# pbr-geoip — country-based routing companion for pbr (nftables/fw4).
# Fetches country CIDR lists from ipdeny.com, maintains nft sets inside
# "table inet fw4" and a pbr_geoip marking chain that runs BEFORE pbr's
# own chains, so traffic to listed countries takes the configured
# interface and everything else falls through to pbr policies untouched.
#
# Persistence:
#   /etc/nftables.d/20-pbr-geoip-sets.nft          sets   (inside fw4 table)
#   /usr/share/nftables.d/ruleset-post/25-pbr-geoip.nft  chain+rules
#   Both are re-applied automatically on every fw4 reload/boot; this
#   script also live-updates the running ruleset without an fw4 reload
#   (an fw4 reload would empty the dnsmasq-populated pbr nft sets).
#
# Config: /etc/config/pbr_geoip   Cron: 40 4 * * *

SETSFILE="/etc/nftables.d/20-pbr-geoip-sets.nft"
RULESFILE="/usr/share/nftables.d/ruleset-post/25-pbr-geoip.nft"
TMPDIR="/tmp/pbr-geoip-tmp"
BASE4="https://www.ipdeny.com/ipblocks/data/countries"
BASE6="https://www.ipdeny.com/ipv6/ipaddresses/blocks"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

log() { echo "$(date '+%H:%M:%S') $*"; }

# ── config ───────────────────────────────────────────────────────────
[ "$(uci -q get pbr_geoip.global.enabled)" = "1" ] || {
	log "pbr_geoip disabled (uci pbr_geoip.global.enabled != 1), exiting"
	exit 0
}
COUNTRIES=$(uci -q get pbr_geoip.global.countries)
IFACE=$(uci -q get pbr_geoip.global.interface)
SRC=$(uci -q get pbr_geoip.global.src_addr)
IPV6=$(uci -q get pbr_geoip.global.ipv6)
[ -n "$COUNTRIES" ] || COUNTRIES="ru by kz"
[ -n "$IFACE" ] || IFACE="wan"
[ -n "$IPV6" ] || IPV6="1"

# ── resolve fw mark for the target interface ─────────────────────────
# Ask the running pbr via ubus (authoritative); fall back to pbr's
# uplink_mark from uci when pbr is not running and IFACE is the uplink.
MARK=$(ubus call luci.pbr getInitStatus '{"name":"pbr"}' 2>/dev/null |
	jsonfilter -e '@.pbr.gatewaysList[@.name="'"$IFACE"'"].mark' 2>/dev/null)
if [ -z "$MARK" ]; then
	UP=$(uci -q get pbr.config.uplink_interface)
	[ -n "$UP" ] || UP="wan"
	if [ "$IFACE" = "$UP" ]; then
		M=$(uci -q get pbr.config.uplink_mark)
		[ -n "$M" ] || M="010000"
		MARK="0x${M#0x}"
		log "pbr not running, using uplink_mark $MARK for '$IFACE'"
	else
		log "ERROR: cannot resolve fw mark for interface '$IFACE' (pbr not running?)"
		exit 1
	fi
fi
FWMASK=$(uci -q get pbr.config.fw_mask)
[ -n "$FWMASK" ] || FWMASK="00ff0000"
FWMASK="0x${FWMASK#0x}"
# keep-mask = bitwise NOT of fw_mask within 32 bits
KEEP=$(printf '0x%08x' $(( ~FWMASK & 0xffffffff )))
log "interface=$IFACE mark=$MARK fw_mask=$FWMASK keep=$KEEP countries='$COUNTRIES'"

mkdir -p "$TMPDIR"
trap 'rm -rf "$TMPDIR"' EXIT

# ── fetch ────────────────────────────────────────────────────────────
fetch_zone() {
	# $1=url $2=outfile ; prints line count or FAIL
	wget -q -T 30 -O "$2" "$1" 2>/dev/null && [ -s "$2" ] &&
		wc -l <"$2" || { echo "FAIL"; return 1; }
}

STATUS_ITEMS=""
for cc in $COUNTRIES; do
	n4=$(fetch_zone "${BASE4}/${cc}.zone" "${TMPDIR}/${cc}.zone")
	n6="-"
	[ "$IPV6" = "1" ] &&
		n6=$(fetch_zone "${BASE6}/${cc}.zone" "${TMPDIR}/${cc}_v6.zone")
	log "  ${cc}: IPv4=${n4} IPv6=${n6}"
	j4=$n4; j6=$n6
	case "$j4" in ''|*[!0-9]*) j4=0;; esac
	case "$j6" in ''|*[!0-9]*) j6=0;; esac
	STATUS_ITEMS="${STATUS_ITEMS}${STATUS_ITEMS:+,}\"${cc}\":{\"v4\":${j4},\"v6\":${j6}}"
done

first=$(echo "$COUNTRIES" | awk '{print $1}')
[ -s "${TMPDIR}/${first}.zone" ] || {
	log "ERROR: no data for primary country '${first}', aborting (keeping old sets)"
	exit 1
}

# ── generate sets file (included INSIDE table inet fw4 by fw4) ──────
make_set() {
	# $1=setname $2=zonefile $3=type
	printf '    set %s {\n        type %s\n        flags interval\n        auto-merge\n        elements = {\n' "$1" "$3"
	awk '{printf "            %s,\n", $0}' "$2" | sed '$s/,$//'
	printf '        }\n    }\n\n'
}

{
	echo "# Generated by pbr-geoip-update: ${DATE}"
	echo "# DO NOT EDIT — fw4 includes this inside \"table inet fw4 { }\""
	echo ""
	for cc in $COUNTRIES; do
		[ -s "${TMPDIR}/${cc}.zone" ] &&
			make_set "geoip_${cc}" "${TMPDIR}/${cc}.zone" "ipv4_addr"
		[ "$IPV6" = "1" ] && [ -s "${TMPDIR}/${cc}_v6.zone" ] &&
			make_set "geoip_${cc}_v6" "${TMPDIR}/${cc}_v6.zone" "ipv6_addr"
	done
} >"${SETSFILE}.tmp" && mv "${SETSFILE}.tmp" "$SETSFILE" || {
	log "ERROR: failed to write $SETSFILE"
	exit 1
}
log "Generated $SETSFILE"

# ── generate routing-chain file (ruleset-post, runs before 30-pbr) ──
# Only mark VALUES are referenced, never pbr's chains: this file is
# applied before pbr's and must not depend on it. Marked packets are
# skipped by pbr_prerouting's own "mark != 0 return" guard.
SRCRULE4=""
if [ -n "$SRC" ]; then
	SRCLIST=$(echo "$SRC" | sed 's/  */, /g')
	SRCRULE4="ip saddr { $SRCLIST } "
fi

{
	echo "#!/usr/sbin/nft -f"
	echo "# Generated by pbr-geoip-update: ${DATE}"
	echo "# Marks traffic to ${COUNTRIES} with ${MARK} (-> pbr '${IFACE}' table)"
	echo ""
	echo "add chain inet fw4 pbr_geoip"
	echo "flush chain inet fw4 pbr_geoip"
	echo "add rule inet fw4 mangle_prerouting jump pbr_geoip"
	echo "add rule inet fw4 pbr_geoip meta mark & ${FWMASK} != 0 return"
	echo "add rule inet fw4 pbr_geoip fib daddr type local return"
	for cc in $COUNTRIES; do
		[ -s "${TMPDIR}/${cc}.zone" ] &&
			echo "add rule inet fw4 pbr_geoip ${SRCRULE4}ip daddr @geoip_${cc} counter meta mark set (meta mark & ${KEEP}) | ${MARK}"
		[ "$IPV6" = "1" ] && [ -s "${TMPDIR}/${cc}_v6.zone" ] &&
			echo "add rule inet fw4 pbr_geoip ip6 daddr @geoip_${cc}_v6 counter meta mark set (meta mark & ${KEEP}) | ${MARK}"
	done
} >"${RULESFILE}.tmp" && mv "${RULESFILE}.tmp" "$RULESFILE" || {
	log "ERROR: failed to write $RULESFILE"
	exit 1
}
log "Generated $RULESFILE"

# ── live update (no fw4 reload) ─────────────────────────────────────
# Sets: create if missing, then flush + batched refill.
reload_set() {
	# $1=setname $2=zonefile $3=type
	[ -s "$2" ] || return 0
	nft list set inet fw4 "$1" >/dev/null 2>&1 ||
		nft add set inet fw4 "$1" "{ type $3; flags interval; auto-merge; }" 2>/dev/null
	nft flush set inet fw4 "$1" 2>/dev/null
	local batch="" count=0 total=0 ip
	while IFS= read -r ip; do
		[ -z "$ip" ] && continue
		batch="${batch:+$batch, }$ip"
		count=$((count + 1)); total=$((total + 1))
		if [ "$count" -ge 500 ]; then
			nft add element inet fw4 "$1" "{ $batch }" 2>/dev/null
			batch=""; count=0
		fi
	done <"$2"
	[ -n "$batch" ] && nft add element inet fw4 "$1" "{ $batch }" 2>/dev/null
	log "  Reloaded set $1: $total entries"
}

for cc in $COUNTRIES; do
	reload_set "geoip_${cc}" "${TMPDIR}/${cc}.zone" "ipv4_addr"
	[ "$IPV6" = "1" ] &&
		reload_set "geoip_${cc}_v6" "${TMPDIR}/${cc}_v6.zone" "ipv6_addr"
done

# Chain: create+hook once, then rebuild its rules from the fresh file.
if ! nft list chain inet fw4 pbr_geoip >/dev/null 2>&1; then
	nft add chain inet fw4 pbr_geoip
	# Hook before pbr's jump: insert puts us at the top of mangle_prerouting.
	nft insert rule inet fw4 mangle_prerouting jump pbr_geoip
	log "Created pbr_geoip chain + hook in mangle_prerouting"
fi
# Atomic rebuild of the chain rules via nft -f (quoting-safe for ( ) | )
{
	echo "flush chain inet fw4 pbr_geoip"
	grep '^add rule inet fw4 pbr_geoip ' "$RULESFILE"
} | nft -f - && log "Live chain pbr_geoip rebuilt" ||
	log "ERROR: live chain rebuild failed"

# GC: drop live sets for countries no longer configured (the chain was
# just rebuilt without them, so the delete succeeds now)
for s in $(nft list sets inet fw4 2>/dev/null | awk '/^\tset geoip_/{print $2}'); do
	cc=${s#geoip_}; cc=${cc%_v6}
	keep=0
	for c in $COUNTRIES; do [ "$c" = "$cc" ] && keep=1; done
	[ "$keep" = "0" ] && nft delete set inet fw4 "$s" 2>/dev/null &&
		log "  GC: removed stale set $s"
done

# Status file consumed by the luci.pbrgeoip rpcd module
printf '{"updated":"%s","interface":"%s","mark":"%s","countries":{%s}}\n' \
	"$DATE" "$IFACE" "$MARK" "$STATUS_ITEMS" >/etc/pbr-geoip.status

log "pbr-geoip update complete"
